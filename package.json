  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "piratetok-live-js": "0.3.0",
    "socket.io": "^4.7.2"
  },
  "engines": {
    "node": ">=22.19.0"
  }
